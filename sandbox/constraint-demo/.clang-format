---
# Formatter configuration for consuming projects. Copy this file to the project root.
#
# Only settings that a normative rule requires appear here; everything else is left to the
# project or to review. A formatter configuration that encodes requirements the rules do
# not state would become a second, hidden rule source, which this library forbids.
#
# Enforced: C-STYLE-FORMAT-001, C-STYLE-BRACES-001, C-STYLE-SWITCH-001, C-STYLE-POINTER-001.
# Review only: C-STYLE-DECLARATION-001, C-STYLE-SIZEOF-001, C-STYLE-COMMENT-001,
#              C-STYLE-INCREMENT-001, C-STYLE-TRAILING-001, C-API-DOCSTYLE-001.
#
# Verify with: clang-format --dry-run --Werror <file>
Language: Cpp

# C-STYLE-FORMAT-001: four spaces per indent level, no tabs.
IndentWidth: 4
TabWidth: 4
UseTab: Never

# C-STYLE-FORMAT-001: the function body opening brace goes on its own line. Control
# statement, enum, struct, union, and extern block braces stay on the declaration line,
# which is what the rule constrains and nothing more.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterExternBlock: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true

# C-STYLE-BRACES-001: every branch uses braces, including single statements.
InsertBraces: true

# C-STYLE-FORMAT-001: a space after control-flow keywords.
SpaceAfterControlStatementKeyword: true

# C-STYLE-FORMAT-001: the return type, name, and parameter list share one line.
AlwaysBreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 1000

# C-STYLE-SWITCH-001: case and default indent one level inside the switch.
IndentCaseLabels: true

# C-STYLE-POINTER-001: the asterisk sits next to the declarator, one per declaration.
PointerAlignment: Right
DerivePointerAlignment: false

# Leave the column of trailing /* ... */ comments alone. Other values pull the Doxygen
# member comments back to the longest entry plus one space, and SpacesBeforeTrailingComments
# only applies to // comments. C-API-DOCSTYLE-001 asks for consistent alignment without
# fixing the column, so it stays a review item.
AlignTrailingComments: Leave

# C-STYLE-TRAILING-001 is not enforced here: clang-format only inserts trailing commas
# in function call arguments and parameters, not in the aggregate initializers the rule
# is about. It stays a review item rather than dragging in unrelated bin-packing changes.

# Not constrained by the rule library. Set this to the project's own limit.
ColumnLimit: 100
...
